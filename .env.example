# Copy to .env and fill in real values for local `cargo run` (or
# `docker compose up`). cargo test only needs the two FIRESTORE_* vars
# below — the JWT signing secret and base URL used in tests are fixed
# test-only constants in tests/common/mod.rs, not read from env.

# GCP project hosting the dev Firestore database.
FIRESTORE_PROJECT_ID=johnhealio-claude-code

# Named Firestore database for local dev (see terraform/dev-bootstrap/).
# Optional — falls back to Firestore's default database id if unset.
FIRESTORE_DATABASE_ID=auth-service-dev

# HMAC signing secret for access tokens, must be at least 32 bytes.
# Generate with: openssl rand -hex 32
JWT_SIGNING_SECRET=replace-with-output-of-openssl-rand-hex-32

# This server's own canonical base URL, used to validate DPoP proofs'
# htu claim. Must match the origin/port a client actually calls.
PUBLIC_BASE_URL=http://localhost:8080
